{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Front-end-facing API of the Boogle Engine Search Service: keyword search over\nProject Gutenberg books with optional author, language and publication-year filters.",
        "title": "Boogle Engine Search API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/",
    "paths": {
        "/search": {
            "get": {
                "description": "Returns one page of the books that contain the keyword `q`, optionally narrowed by author,\nlanguage and original publication year. Filters can be combined and are joined with AND.\nEmpty filter values (for example `author=`) are treated as absent.\nOnly the filters that were applied are echoed in `filters`; the object is `{}` when none were sent.\nResults are ordered by relevance, most relevant first, with ties broken by ascending `book_id`.\n`total` counts every match, while `results` holds at most `limit` books starting at `offset`.\nA valid query without matches, or an `offset` past the last match, returns 200 with `results: []`.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Search books by keyword",
                "parameters": [
                    {
                        "minLength": 1,
                        "type": "string",
                        "example": "adventure",
                        "description": "Keyword to search for; surrounding spaces are ignored",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "Austen",
                        "description": "Case-insensitive partial match on the author name",
                        "name": "author",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "example": "en",
                        "description": "ISO 639 language code, case-insensitive exact match (en, es, fr...)",
                        "name": "language",
                        "in": "query"
                    },
                    {
                        "maximum": 9999,
                        "minimum": 1,
                        "type": "integer",
                        "example": 1813,
                        "description": "Exact original publication year",
                        "name": "year",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "default": 0,
                        "description": "Number of matches to skip before the first result",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 20,
                        "description": "Maximum number of results in the page",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "One page of matching books",
                        "schema": {
                            "$ref": "#/definitions/api.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "q is missing (missing_parameter) or a parameter is malformed (invalid_parameter)",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "The search engine failed (internal_error)",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.BookResult": {
            "type": "object",
            "properties": {
                "author": {
                    "type": "string",
                    "example": "Jane Austen"
                },
                "book_id": {
                    "type": "integer",
                    "example": 1342
                },
                "language": {
                    "description": "ISO 639 code; books written in several languages list them comma-separated (\"en,fr\")",
                    "type": "string",
                    "example": "en"
                },
                "title": {
                    "type": "string",
                    "example": "Pride and Prejudice"
                },
                "year": {
                    "description": "Original publication year, or 0 when unknown",
                    "type": "integer",
                    "example": 1813
                }
            }
        },
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "enum": [
                        "missing_parameter",
                        "invalid_parameter",
                        "internal_error"
                    ],
                    "example": "invalid_parameter"
                },
                "message": {
                    "type": "string",
                    "example": "query parameter \"limit\" must be an integer between 1 and 100"
                }
            }
        },
        "api.SearchFilters": {
            "type": "object",
            "properties": {
                "author": {
                    "type": "string",
                    "example": "Jane Austen"
                },
                "language": {
                    "type": "string",
                    "example": "en"
                },
                "year": {
                    "type": "integer",
                    "example": 1813
                }
            }
        },
        "api.SearchResponse": {
            "type": "object",
            "properties": {
                "filters": {
                    "description": "Filters that were applied; absent filters are omitted",
                    "allOf": [
                        {
                            "$ref": "#/definitions/api.SearchFilters"
                        }
                    ]
                },
                "limit": {
                    "type": "integer",
                    "example": 20
                },
                "offset": {
                    "type": "integer",
                    "example": 0
                },
                "query": {
                    "description": "Keyword that was searched, without surrounding spaces",
                    "type": "string",
                    "example": "adventure"
                },
                "results": {
                    "description": "Books of the requested page; never null",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.BookResult"
                    }
                },
                "total": {
                    "description": "Number of matches across all pages",
                    "type": "integer",
                    "example": 25
                }
            }
        }
    },
    "tags": [
        {
            "description": "Keyword search with metadata filters and pagination",
            "name": "search"
        }
    ]
}