# Host ports published by the compose stack. Copy this file to .env to change them;
# the services keep talking to each other by container name inside the compose network.
INGESTION_PORT=7001
INDEXING_PORT=7002
SEARCH_PORT=7003
MONGO_PORT=27017

# Browser origins allowed to call the Search API cross-origin (CORS): * for any origin (the
# default), or a comma-separated list such as https://boogle.example.com,http://localhost:5173.
CORS_ALLOWED_ORIGIN=*

# Search Service replicas behind nginx, which publishes SEARCH_PORT (audit RF 8). Compare 1 and 2
# with the same k6 profile; `docker compose up -d --scale search=N` overrides this value.
SEARCH_REPLICAS=1
